# Neon Postgres connection string (must include sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better-Auth secret — generate with: openssl rand -hex 32
# Must be unique per environment (different for dev and prod)
BETTER_AUTH_SECRET=your-random-secret-at-least-32-characters

# Better-Auth URL — public URL of this auth service
# Production: https://auth-xxx.railway.app
BETTER_AUTH_URL=http://localhost:3005

# Frontend URL — used for CORS origin and email redirect links (no trailing slash)
# Production: https://mhoodkhatri.github.io
FRONTEND_URL=http://localhost:3000

# Brevo (Sendinblue) transactional email
BREVO_API_KEY=xkeysib-xxxx
BREVO_SENDER_EMAIL=your-verified@email.com
BREVO_SENDER_NAME=Robotics Textbook

# PORT is injected automatically by Railway — do not set in production
# PORT=3005
