# Groq API (primary LLM provider)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Qdrant Cloud (required for production)
# Leave QDRANT_URL empty in local dev to use local qdrant_data/ instead
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# Neon Postgres (shared with auth-service for session validation)
# Must include sslmode=require for Neon SSL enforcement
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# CORS Origins — comma-separated list of allowed origins (no wildcard in production)
# Leave empty in local dev to use localhost defaults (http://localhost:3000, etc.)
# Production example: CORS_ORIGINS=https://mhoodkhatri.github.io
CORS_ORIGINS=

# Server configuration (Railway injects PORT automatically)
HOST=0.0.0.0
PORT=8000

# Optional: Google AI API Key (Gemini backup — Groq is primary)
# GOOGLE_API_KEY=your_google_api_key_here

# Optional: path to cache fastembed ONNX models (defaults to backend/.embedding_cache)
# EMBEDDING_CACHE_DIR=/app/.embedding_cache
